# Produkcja: statyczny build Vite serwowany przez nginx.
# Backend (Django) oczekiwany pod nazwa `project1-backend:8000`
# (patrz nginx.prod.conf). Na VPS: build z Dockerfile.prod.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
